# Existing services
TUNNEL_TOKEN=
TMDB_READ_ACCESS_TOKEN=

# Published by GitHub Actions. Use :edge for the current project branch or
# :latest after the release is merged to main.
MEDIA_VAULT_IMAGE=ghcr.io/cazvisuals/caz-media-vault:edge

# Public username/password protection
AUTH_USERNAME=
AUTH_PASSWORD=
# Generate at least 32 random characters. Example: openssl rand -hex 32
AUTH_SECRET=

# NAS-friendly automation (local hours, 24-hour clock)
CONVERSION_SCHEDULE_ENABLED=true
CONVERSION_START_HOUR=0
CONVERSION_END_HOUR=7
MAINTENANCE_ENABLED=true
MAINTENANCE_HOUR=4
